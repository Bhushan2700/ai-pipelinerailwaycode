# ── FileMaker Data API ──────────────────────────────────────────────
# FM__HOST must be the full base URL, e.g. https://192.168.1.100 or https://fm.yourcompany.com
# Do NOT add a trailing slash
FM__HOST=https://your-filemaker-server.example.com
FM__DATABASE=SurveyDatabase
FM__USERNAME=api_user
FM__PASSWORD=change_me_in_production
FM__LAYOUT_RESPONSES=N8N_SURVEY_EVENTS
FM__LAYOUT_CLUSTERS=ClusterResults
FM__LAYOUT_REPORTS=GeneratedReports
FM__TOKEN_REFRESH_INTERVAL=900

# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI__API_KEY=sk-proj-...your-key-here...
OPENAI__EMBEDDING_MODEL=text-embedding-3-small
OPENAI__COMPLETION_MODEL=gpt-4o
OPENAI__EMBEDDING_BATCH_SIZE=75
OPENAI__MAX_RETRIES=3
OPENAI__RETRY_BACKOFF_BASE=2.0

# ── Redis ────────────────────────────────────────────────────────────
# Local host run (no containers):
# REDIS__URL=redis://localhost:6379/0
# Docker/Compose run:
REDIS__URL=redis://redis:6379/0
REDIS__JOB_TIMEOUT=3600
REDIS__RESULT_TTL=86400

# ── Clustering ───────────────────────────────────────────────────────
CLUSTERING__MIN_CLUSTER_SIZE=5
CLUSTERING__MIN_SAMPLES=3
CLUSTERING__METRIC=cosine
CLUSTERING__CLUSTER_SELECTION_METHOD=eom
# ── Webhook Security ────────────────────────────────────────────────────────
WEBHOOK_API_KEY=fm-secret-key-change-me
# ── Application ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Hosting / CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins, or "*" for all (dev only)
ALLOWED_ORIGINS=*
# Public URL where this API is reachable (used in responses & docs)
BASE_URL=http://localhost:8000
